---
import "../brand/tokens.css";

interface Props {
  title: string;
  description: string;
  themeClass: string;
}

const { title, description, themeClass } = Astro.props;
const enableGoogleAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" class={themeClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      enableGoogleAnalytics && (
        <>
          <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-KS98PZS9BN"
          />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-KS98PZS9BN");
          </script>
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
